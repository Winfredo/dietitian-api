{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "noUncheckedIndexedAccess": true,
    "moduleDetection": "force",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*", "tests/**/*"]
}